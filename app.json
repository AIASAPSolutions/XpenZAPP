{
  "expo": {
    "name": "XpenZtrack",
    "slug": "xpenztrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aiasap.xpenztrack",
      "infoPlist": {
        "NSCameraUsageDescription": "XpenZtrack needs camera access to scan receipts and bills.",
        "NSPhotoLibraryUsageDescription": "XpenZtrack needs photo library access to upload receipt images.",
        "NSMicrophoneUsageDescription": "XpenZtrack uses the microphone for voice expense logging."
      }
    },
    "android": {
      "package": "com.aiasap.xpenztrack",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#3730a3",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#3730a3"
        }
      ],
      "expo-secure-store",
      "expo-camera",
      "expo-image-picker",
      "expo-notifications",
      "expo-sharing"
    ]
  }
}